{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#globals.css": "./src/app/globals.css",
    "#api": "./src/api/server/index.ts",
    "#api/client": "./src/api/client/index.ts",
    "#api/types": "./src/api/types/index.ts"
  },
  "scripts": {
    "api": "nodemon --watch src/api/__mocks__ --ext ts,json --exec \"tsx src/api/__mocks__/server.ts\"",
    "routes": "tsx scripts/routes.ts",
    "dev": "concurrently -k -n api,next \"pnpm:api\" \"pnpm:next\"",
    "next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.2.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@next/env": "16.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4",
    "@types/express": "5.0.6",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "concurrently": "9.2.1",
    "eslint": "9",
    "eslint-config-next": "16.2.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "express": "5.2.1",
    "nodemon": "3.1.14",
    "tailwindcss": "4",
    "tsx": "4.21.0",
    "typescript": "5"
  }
}
