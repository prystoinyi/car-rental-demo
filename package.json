{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#globals.css": "./src/app/globals.css",
    "#api": "./src/api/server/index.ts",
    "#api/client": "./src/api/client/index.ts",
    "#api/types": "./src/api/types/index.ts"
  },
  "scripts": {
    "api": "nodemon --watch src/api/__mocks__ --ext ts,json --exec \"tsx src/api/__mocks__/server.ts\"",
    "routes": "tsx scripts/routes.ts",
    "dev": "concurrently -k -n api,next \"pnpm:api\" \"pnpm:next\"",
    "next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@jetbrains/typescript-plugin-css-modules": "5.3.1",
    "@next/env": "16.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "express": "5.2.1",
    "nodemon": "3.1.14",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
